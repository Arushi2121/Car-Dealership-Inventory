VITE_API_URL=http://localhost:4000

# Public demo credentials only. They ship in the frontend bundle, so anyone can read them.
# Use the same values as DEMO_USER_* and ADMIN_* in backend/.env, and never reuse them anywhere real.
VITE_DEMO_USER_EMAIL=demo@example.com
VITE_DEMO_USER_PASSWORD=change-me-demo-user
VITE_DEMO_ADMIN_EMAIL=admin@example.com
VITE_DEMO_ADMIN_PASSWORD=change-me-demo-admin
